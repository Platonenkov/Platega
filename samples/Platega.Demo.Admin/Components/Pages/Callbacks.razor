@page "/callbacks"
@attribute [Authorize]
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject CallbackProcessor CallbackProcessor

<PageTitle>Callback-журнал — Platega Admin</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Callback-журнал</h1>
    <div class="d-flex gap-3 align-items-center">
        <div class="form-check form-switch mb-0">
            <input class="form-check-input" type="checkbox" id="auto" checked="@_autoRefresh" @onchange="e => ToggleAutoRefresh((bool)e.Value!)" />
            <label class="form-check-label" for="auto">Автообновление</label>
        </div>
        <button class="btn btn-outline-secondary btn-sm" @onclick="LoadAsync">Обновить</button>
    </div>
</div>
<p class="text-muted small">Все входящие уведомления Platega, включая отклонённые. Статус заказа всё равно перепроверяется через API.</p>

@if (_entries is { Count: > 0 })
{
    <table class="table table-sm align-middle">
        <thead><tr><th>Получен</th><th>Результат</th><th>Тип</th><th>Объект</th><th>Статус</th><th></th></tr></thead>
        <tbody>
            @foreach (CallbackLogEntry entry in _entries)
            {
                <tr>
                    <td>@DemoFormat.Date(entry.ReceivedAt)</td>
                    <td>
                        @if (entry.Accepted)
                        {
                            <span class="badge text-bg-success">принят</span>
                        }
                        else
                        {
                            <span class="badge text-bg-danger" title="@entry.Error">отклонён</span>
                        }
                    </td>
                    <td>@(entry.Kind ?? entry.Error)</td>
                    <td class="small text-muted">@entry.ObjectId</td>
                    <td>@entry.Status</td>
                    <td><button class="btn btn-link btn-sm p-0" @onclick="() => _expanded = _expanded == entry.Id ? null : entry.Id">JSON</button></td>
                </tr>
                @if (_expanded == entry.Id)
                {
                    <tr><td colspan="6"><pre class="small mb-0 text-wrap">@entry.RawBody</pre></td></tr>
                }
            }
        </tbody>
    </table>
}
else if (_entries is not null)
{
    <p>Callback-ов пока не было. Для реального Platega укажите в ЛК публичный HTTPS-адрес <code>/platega/callback</code> этого приложения.</p>
}

@code {
    private readonly CancellationTokenSource _disposed = new CancellationTokenSource();
    private IReadOnlyList<CallbackLogEntry>? _entries;
    private long? _expanded;
    private bool _autoRefresh;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync() => _entries = await CallbackProcessor.RecentAsync(200, _disposed.Token);

    private async Task ToggleAutoRefresh(bool enabled)
    {
        _autoRefresh = enabled;
        if (!enabled)
        {
            return;
        }

        using PeriodicTimer timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
        try
        {
            while (_autoRefresh && await timer.WaitForNextTickAsync(_disposed.Token))
            {
                await LoadAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    public async ValueTask DisposeAsync()
    {
        await _disposed.CancelAsync();
        _disposed.Dispose();
    }
}
