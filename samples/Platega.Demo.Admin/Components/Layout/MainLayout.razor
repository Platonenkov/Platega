@inherits LayoutComponentBase
@inject Microsoft.Extensions.Options.IOptions<Platega.PlategaOptions> PlategaOptions

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 gap-3">
            <span class="text-muted small">Платёжный шлюз: @PlategaOptions.Value.BaseAddress</span>
            <AuthorizeView>
                <form method="post" action="account/logout" class="m-0">
                    <AntiforgeryToken />
                    <button type="submit" class="btn btn-link btn-sm p-0">Выйти</button>
                </form>
            </AuthorizeView>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Произошла ошибка.
    <a href="." class="reload">Перезагрузить</a>
    <span class="dismiss">🗙</span>
</div>
