@page "/"

<PageTitle>Каталог — Platega Shop</PageTitle>

<h1>Каталог</h1>
<p class="text-muted">Демо-магазин для проверки приёма оплаты через Platega.</p>

<div class="row row-cols-1 row-cols-md-2 row-cols-xl-4 g-3">
    @foreach (Product product in DemoCatalog.Products)
    {
        <div class="col">
            <div class="card h-100">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">@product.Name</h5>
                    <p class="card-text text-muted flex-grow-1">@product.Description</p>
                    <p class="fs-4 fw-semibold mb-3">@DemoFormat.Money(product.Price, product.Currency)</p>
                    <a class="btn btn-primary" href="checkout/@product.Code">Купить</a>
                </div>
            </div>
        </div>
    }
</div>
