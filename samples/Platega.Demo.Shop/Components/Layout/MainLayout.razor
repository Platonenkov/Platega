@inherits LayoutComponentBase
@inject Microsoft.Extensions.Options.IOptions<Platega.PlategaOptions> PlategaOptions

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <span class="text-muted small">Платёжный шлюз: @PlategaOptions.Value.BaseAddress</span>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Произошла ошибка.
    <a href="." class="reload">Перезагрузить</a>
    <span class="dismiss">🗙</span>
</div>
